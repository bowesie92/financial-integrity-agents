def test_finish_review_rejects_a_fraud_conclusion(ctx):
    base = {"summary": "Reviewed the ledger. No fraud indicators were detected.", "checked": ["digit tests"]}
    assert run(ctx, "finish_review", **base)["error"]["code"] == "invalid_input"
