# Names only. Copy each block into the real file, fill in your own values, and keep the real files
# outside the repo (the author uses /etc/financial-integrity-agents-secrets/, mode 700 folder, mode 600 files).
# The repository's .gitignore blocks *.env and .env*, so a filled-in copy cannot be committed by accident.

# --- anthropic.env ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- supabase.env ---
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_POOLER_HOST=your-session-pooler-host
SUPABASE_DB_PASSWORD=password-of-the-database-owner-role
SUPABASE_FIA_ADMIN_PASSWORD=password-you-choose-for-fia_admin
SUPABASE_FIA_AGENT_PASSWORD=password-you-choose-for-fia_agent
SUPABASE_FIA_NOTIFIER_PASSWORD=password-you-choose-for-fia_notifier
